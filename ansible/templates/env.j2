# Environment config for EC2 deployment
# Variables from group_vars and extra vars (-e)
FLASK_SECRET_KEY={{ flask_secret_key }}
FLASK_ENV=production
APP_PORT={{ app_port }}
GHCR_IMAGE={{ ghcr_image }}
DATABASE_URL=postgresql://{{ postgres_user | default('modulego') }}:{{ postgres_password | default('modulego') }}@postgres:5432/{{ postgres_db | default('modulego') }}
POSTGRES_USER={{ postgres_user | default('modulego') }}
POSTGRES_PASSWORD={{ postgres_password | default('modulego') }}
POSTGRES_DB={{ postgres_db | default('modulego') }}
GRAFANA_PORT={{ grafana_port | default('3000') }}
GRAFANA_ADMIN_USER={{ grafana_admin_user | default('admin') }}
GRAFANA_ADMIN_PASSWORD={{ lookup('env', 'GRAFANA_ADMIN_PASSWORD') }}
{% if commit_hash | default('') %}
COMMIT_HASH={{ commit_hash }}
{% endif %}
{% if gemini_api_key | default('') %}
GEMINI_API_KEY={{ gemini_api_key }}
{% endif %}
{% if gemini_model | default('') %}
GEMINI_MODEL={{ gemini_model | default('gemini-3.1-flash-lite') }}
{% endif %}
