# Copy this file to .env and replace the placeholders with values.

# Stable random value used to sign Flask sessions and 30-day guest cookies.
# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_a_long_random_value

# Server-only Gemini key used for live comparison summaries.
# Create it in Google AI Studio and never expose it in browser JavaScript.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. The default supports free-tier structured output.
GEMINI_MODEL=gemini-3.1-flash-lite

# PostgreSQL connection string.
# docker-compose sets this automatically.
# DATABASE_URL=postgresql://modulego:modulego@localhost:5432/modulego
