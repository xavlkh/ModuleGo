# Copy this file to .env and replace the placeholders with values from:
# Supabase Dashboard > Project Settings > API.

# URL of the shared Supabase project (use the Singapore project URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# Backend-only Supabase secret key (starts with sb_secret_).
# Never expose this key in browser JavaScript or commit a real key to Git.
SUPABASE_SECRET_KEY=sb_secret_your_backend_key_here

# Server-only Gemini key used for live comparison summaries.
# Create it in Google AI Studio and never expose it in browser JavaScript.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. The default supports free-tier structured output.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Set to use PostgreSQL instead of SQLite for reviews.
# docker-compose and k8s/ set this automatically.
# DATABASE_URL=postgresql://modulego:modulego@localhost:5432/modulego

# SQLite is used only by automated tests. Normal local and Vercel runs use
# the shared Supabase database for both module data and reviews.
