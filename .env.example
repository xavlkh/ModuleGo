# Copy this file to .env and fill in the values you need.

# Stable random value used to sign Flask sessions and 30-day guest cookies.
# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_a_long_random_value

# Server-only Gemini key for AI-powered comparisons and chatbot.
# Get one from: https://aistudio.google.com/apikey
# Optional — app works without it, AI features just won't have summaries.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Default: gemini-3.1-flash-lite (free tier).
# GEMINI_MODEL=gemini-2.5-flash

# Local monitoring ports bind to 127.0.0.1 and are not publicly exposed.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# Required for EC2. Generate a long password and store it in GitHub Secrets.
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_monitoring_password
